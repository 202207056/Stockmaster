# DB 설정 (팀 공용 PostgreSQL 주소로 변경)
DATABASE_URL=postgresql://postgres:비밀번호@localhost:5432/gpnew

# JWT 설정 (랜덤 문자열로 변경 - 절대 외부 공유 금지)
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# 외부 증권 API (한국투자증권 오픈API)
KIS_APP_KEY=your-kis-app-key
KIS_APP_SECRET=your-kis-app-secret
KIS_ACCOUNT_NO=your-account-no

# Gemini API (투자성향 설문 분석)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
